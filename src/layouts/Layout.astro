---
import '../styles/global.css';
import { siteInfo } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	noIndex?: boolean;
	chrome?: boolean;
}

const {
	title = siteInfo.title,
	description = siteInfo.description,
	ogImage = siteInfo.ogImage,
	noIndex = false,
	chrome = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteInfo.url);
const ogImageURL = new URL(ogImage, Astro.site || siteInfo.url);
const socialImageAlt = 'Jacob Drury — tools, projects, and experiments';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0b1220" />
		<style>
			body { margin: 0; background: #070d18; color: rgba(255, 255, 255, 0.92); font-family: Inter, ui-sans-serif, system-ui, sans-serif; line-height: 1.5; }
			a { color: inherit; text-decoration: none; }
			.site-main { display: block; min-width: 0; }
			.skip-link { opacity: 0; pointer-events: none; }
			.site-header { visibility: hidden; }
			.site-header__inner { display: flex; align-items: center; justify-content: space-between; }
			.desktop-nav { display: flex; align-items: center; }
			.mobile-nav { display: none; }
			.mobile-nav summary { font-size: 0; list-style: none; }
			.mobile-nav nav { display: none; }
			@media (max-width: 760px) {
				.desktop-nav { display: none; }
				.mobile-nav { display: block; }
				.site-brand__text { display: none; }
			}
		</style>
		
		{/* Primary Meta Tags */}
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={siteInfo.author} />
		<link rel="canonical" href={canonicalURL} />
		
		{/* Open Graph / Facebook */}
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta property="og:site_name" content="Jacob Drury" />
		<meta property="og:locale" content="en_US" />
		
		{/* Twitter */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
		
		{/* Robots */}
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		
		{/* Favicons */}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
	</head>
	<body>
		<a class="skip-link" href="#main-content" style="opacity: 0; pointer-events: none;">Skip to main content</a>
		{chrome && <SiteHeader />}
		<main id="main-content" class:list={['site-main', { 'site-main--with-chrome': chrome }]} tabindex="-1">
			<slot />
		</main>
		{chrome && <SiteFooter />}
	</body>
</html>
