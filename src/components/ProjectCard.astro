---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-card__top">
    <span>{project.type}</span>
    <span class="status"><i aria-hidden="true"></i>{project.status}</span>
  </div>
  <div>
    <h3><a href={project.href}>{project.name}</a></h3>
    <p>{project.summary}</p>
  </div>
  <ul aria-label={`${project.name} technologies`}>
    {project.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <a class="project-card__link" href={project.href}>View project <span aria-hidden="true">↗</span></a>
</article>

<style>
  .project-card {
    min-height: 100%;
    padding: clamp(22px, 3vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 26px;
    border: 1px solid var(--stroke-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgba(30, 41, 59, 0.82), rgba(15, 25, 42, 0.9));
    box-shadow: var(--shadow-soft);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: rgba(96, 165, 250, 0.35);
  }

  .project-card__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status { display: inline-flex; align-items: center; gap: 7px; color: var(--good); }
  .status i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 12px currentColor; }

  h3 { margin: 0; font-size: clamp(22px, 3vw, 29px); letter-spacing: -0.03em; }
  h3 a:hover { color: var(--accent-soft); }
  p { margin: 12px 0 0; color: var(--muted); line-height: 1.7; }

  ul {
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
  }

  li {
    padding: 6px 9px;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .project-card__link {
    color: var(--accent-soft);
    font-size: 13px;
    font-weight: 750;
  }
</style>
