---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a class="project-card" href={`/projects/${project.slug}`} aria-label={`Read about ${project.name}`}>
  <div class="project-card__top">
    <span>{project.type}</span>
    <span class="status"><i aria-hidden="true"></i>{project.status}</span>
  </div>
  <div>
    <h3>{project.name}</h3>
    <p>{project.summary}</p>
  </div>
  <ul aria-label={`${project.name} technologies`}>
    {project.technologies.map((technology) => <li>{technology}</li>)}
  </ul>
  <span class="project-card__link">Read case study <span aria-hidden="true">→</span></span>
</a>

<style>
  .project-card {
    min-height: 100%;
    padding: clamp(22px, 3vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 26px;
    border: 1px solid var(--stroke-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgba(30, 41, 59, 0.82), rgba(15, 25, 42, 0.9));
    box-shadow: var(--shadow-soft);
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: rgba(96, 165, 250, 0.35);
    background: linear-gradient(145deg, rgba(34, 47, 70, 0.92), rgba(17, 29, 47, 0.96));
    box-shadow: 0 22px 52px rgba(0, 0, 0, 0.32);
  }

  .project-card:hover h3,
  .project-card:focus-visible h3 { color: var(--accent-soft); }

  .project-card:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.78);
    outline-offset: 4px;
    border-color: rgba(245, 158, 11, 0.58);
  }

  .project-card:active { transform: translateY(-1px) scale(0.995); }

  .project-card__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status { display: inline-flex; align-items: center; gap: 7px; color: var(--good); }
  .status i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 12px currentColor; }

  h3 { margin: 0; font-size: clamp(22px, 3vw, 29px); letter-spacing: -0.03em; }
  p { margin: 12px 0 0; color: var(--muted); line-height: 1.7; }

  ul {
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
  }

  li {
    padding: 6px 9px;
    border: 1px solid var(--stroke);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
    color: var(--accent-soft);
    font-size: 13px;
    font-weight: 750;
  }
</style>
