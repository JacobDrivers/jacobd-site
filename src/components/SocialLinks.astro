---
import { socialLinks } from '../data/site';

interface Props {
  compact?: boolean;
  iconOnly?: boolean;
}

const { compact = false, iconOnly = false } = Astro.props;
---

<nav class:list={['social-links', { compact, 'icon-only': iconOnly }]} aria-label="Social profiles">
  {socialLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={iconOnly ? `${link.name} profile (opens in a new tab)` : undefined}
      title={iconOnly ? link.name : undefined}
    >
      {iconOnly ? (
        link.name === 'GitHub' ? (
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.86-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99h3.41v1.57h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.28 2.37 4.28 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V8.99h3.56v11.46ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
        )
      ) : (
        <>
          <span>{link.name}</span>
          <span aria-hidden="true">↗</span>
        </>
      )}
    </a>
  ))}
</nav>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 12px;
    border: 1px solid var(--stroke-strong);
    border-radius: 10px;
    background: rgba(17, 28, 46, 0.72);
    color: var(--muted);
    font-size: 13px;
    font-weight: 650;
    transition: color 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .social-links a:hover {
    color: var(--text);
    border-color: rgba(52, 211, 153, 0.4);
    transform: translateY(-1px);
  }

  .social-links a:focus-visible {
    color: var(--text);
    border-color: rgba(245, 158, 11, 0.65);
    background: rgba(245, 158, 11, 0.08);
  }

  .compact a {
    min-height: 36px;
    padding: 7px 10px;
  }

  .icon-only a {
    width: 42px;
    height: 42px;
    min-height: 42px;
    padding: 0;
    justify-content: center;
    background: transparent;
    color: var(--faint);
  }

  .icon-only a:hover {
    color: var(--good);
    background: rgba(52, 211, 153, 0.06);
  }

  .icon-only svg {
    width: 18px;
    height: 18px;
    display: block;
  }
</style>
