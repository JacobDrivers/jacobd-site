---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.name} | Jacob Drury`} description={project.summary}>
  <PageIntro eyebrow={`${project.type} · ${project.status}`} title={project.name} description={project.summary}>
    <div slot="actions">
      <a class="button button--primary" href={project.href}>Launch live project <span aria-hidden="true">↗</span></a>
      <a class="button button--quiet" href="/projects">All projects</a>
    </div>
  </PageIntro>

  <section class="case-study" aria-labelledby="project-context">
    <article class="content-panel context-panel">
      <p class="kicker">Why I built it</p>
      <h2 id="project-context">A practical problem turned into a working project.</h2>
      <p>{project.problem}</p>
    </article>

    <article class="content-panel">
      <p class="kicker">What it does</p>
      <ul class="highlight-list">
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </article>
  </section>

  <section class="content-section project-details" aria-labelledby="project-stack">
    <div>
      <p class="kicker">Built with</p>
      <h2 id="project-stack">Technical surface</h2>
    </div>
    <ul class="technology-list" aria-label={`${project.name} technologies`}>
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </section>
</Layout>

<style>
  .case-study {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 18px;
  }

  .context-panel {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.88), rgba(15, 25, 42, 0.94));
  }

  .kicker {
    margin: 0 0 12px;
    color: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(26px, 4vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .content-panel > p:last-child {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.8;
  }

  .highlight-list,
  .technology-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .highlight-list {
    display: grid;
    gap: 14px;
  }

  .highlight-list li {
    padding: 0 0 14px 20px;
    border-bottom: 1px solid var(--stroke);
    color: var(--muted);
    line-height: 1.6;
    position: relative;
  }

  .highlight-list li::before {
    content: '';
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 12px var(--good);
  }

  .project-details {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 28px;
    align-items: start;
  }

  .project-details h2 { font-size: clamp(28px, 4vw, 46px); }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .technology-list li {
    padding: 9px 12px;
    border: 1px solid var(--stroke-strong);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .case-study,
    .project-details { grid-template-columns: 1fr; }
  }
</style>
