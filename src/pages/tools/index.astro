---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/site';

const liveTools = tools.filter((tool) => !tool.disabled);
const upcomingTools = tools.filter((tool) => tool.disabled);
---

<Layout title="Tools | Jacob Drury" description="Useful tools, games, and interactive experiments built by Jacob Drury.">
  <PageIntro
    eyebrow="Tools hub"
    title="Useful things, ready to run."
    description="Practical utilities and interactive experiments. The tools keep their focused interfaces while sharing a clearer home within the personal site."
  />

  <section class="content-section">
    <SectionHeading eyebrow="Live" title="Available now." description="Every live item opens the existing working route." />
    <div class="tool-grid">
      {liveTools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>

  <section class="content-section upcoming">
    <SectionHeading eyebrow="Planned" title="Ideas in the queue." description="These labels are retained from the existing hub and do not represent release commitments." />
    <div class="tool-grid">
      {upcomingTools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</Layout>

<style>
  .upcoming { padding-bottom: 86px; }
</style>
