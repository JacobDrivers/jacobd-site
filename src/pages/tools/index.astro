---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/site';
---

<Layout title="Tools | Jacob Drury" description="Practical tools, games, and interactive experiments available on Jacob Drury's site.">
  <PageIntro
    eyebrow="Tools hub"
    title="Tools and experiments"
    description="Practical utilities, references, games, and interactive experiments available to use."
  />

  <section class="content-section">
    <SectionHeading eyebrow="Available now" title="Choose a tool or experiment" description="Coin Scout includes its coin library, inventory, paper currency reference, and auction mode in one workspace." />
    <div class="tool-grid">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</Layout>
