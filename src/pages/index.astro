---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ToolCard from '../components/ToolCard.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { tools } from '../data/site';

const featuredProjects = projects.filter((project) => project.featured);
const liveTools = tools.slice(0, 3);
---

<Layout
  title="Jacob Drury | Tools, Projects + Experiments"
  description="Jacob Drury builds practical tools, interactive projects, and experiments."
>
  <section class="home-hero">
    <PageIntro eyebrow={profile.eyebrow} title={profile.headline} description={profile.introduction}>
      <div slot="actions" class="hero-actions">
        <p class="hero-focus">{profile.technicalFocus}</p>
        <div class="hero-actions__row">
          <div class="hero-actions__primary">
            <a class="button button--primary" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
            <a class="button button--quiet" href="/tools">Open tools</a>
          </div>
          <SocialLinks iconOnly={true} />
        </div>
      </div>
    </PageIntro>

    <aside class="hero-signal" aria-label="Site overview">
      <div class="hero-signal__header">
        <span>Current build</span>
        <i aria-hidden="true"></i>
      </div>
      <dl>
        <div><dt>Projects</dt><dd>{projects.length} available now</dd></div>
        <div><dt>Tools</dt><dd>{liveTools.length} live routes</dd></div>
        <div><dt>Built with</dt><dd>Astro</dd></div>
      </dl>
    </aside>
  </section>

  <section class="content-section" aria-labelledby="featured-projects">
    <SectionHeading
      eyebrow="Selected work"
      title="Selected projects"
      id="featured-projects"
      description="A small selection of practical tools and interactive experiments already running on this site."
      linkHref="/projects"
      linkLabel="All projects"
    />
    <div class="card-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="content-section" aria-labelledby="available-tools">
    <SectionHeading
      eyebrow="Available now"
      title="Tools"
      id="available-tools"
      description="Open the tools hub for calculators, references, and interactive experiments."
      linkHref="/tools"
      linkLabel="Browse tools"
    />
    <div class="tool-grid">
      {liveTools.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>

  <section class="content-section home-about">
    <div>
      <p class="home-about__eyebrow">About the work</p>
      <h2>{profile.shortBio}</h2>
    </div>
    <div>
      <p>{profile.about[0]}</p>
      <p>{profile.about[1]}</p>
      <a class="text-link" href="/about">More about me <span aria-hidden="true">→</span></a>
      <SocialLinks />
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    min-height: min(780px, calc(100vh - 76px));
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.7fr);
    align-items: center;
    gap: clamp(36px, 7vw, 90px);
  }

  .hero-actions {
    display: grid;
    gap: 15px;
  }

  .hero-focus {
    margin: 0;
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 650;
    line-height: 1.7;
    letter-spacing: 0.045em;
  }

  .hero-actions__row,
  .hero-actions__primary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-actions__row { gap: 14px; }

  .hero-signal {
    position: relative;
    padding: 22px;
    overflow: hidden;
    border: 1px solid var(--stroke-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(17, 28, 46, 0.9), rgba(10, 19, 32, 0.94));
    box-shadow: var(--shadow-soft);
  }

  .hero-signal::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 49%, rgba(52, 211, 153, 0.08) 50%, transparent 51%);
    background-size: 42px 100%;
    pointer-events: none;
  }

  .hero-signal__header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--good);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-signal__header i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 16px var(--good);
  }

  dl { position: relative; margin: 28px 0 0; }
  dl div { padding: 14px 0; display: grid; grid-template-columns: 76px 1fr; gap: 16px; border-top: 1px solid var(--stroke); }
  dt { color: var(--faint); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  dd { margin: 0; color: var(--text); font-size: 13px; font-weight: 650; }
  .home-about {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(36px, 8vw, 110px);
  }

  .home-about__eyebrow { margin: 0 0 12px; color: var(--blue); font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; }
  .home-about h2 { margin: 0; max-width: 14ch; font-size: clamp(30px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.045em; }
  .home-about > div:last-child > p { margin: 0 0 16px; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .text-link { display: inline-block; margin: 8px 0 28px; color: var(--accent-soft); font-size: 13px; font-weight: 750; }

  @media (max-width: 860px) {
    .home-hero { min-height: auto; grid-template-columns: 1fr; padding-bottom: 56px; }
    .hero-signal { max-width: 620px; }
  }

  @media (max-width: 680px) {
    .home-about { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
